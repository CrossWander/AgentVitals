<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Свой вид у каждого контрола: от Fluent остаётся только основа окна и текста.
         Цвета — роли палитры, поэтому смена темы перекрашивает всё сама. -->

    <!-- Пилюля: обычная кнопка с подписью и значком -->
    <ControlTheme x:Key="Pill" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Pill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PillLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </ControlTheme>

    <!-- Главное действие экрана: фирменный градиент -->
    <ControlTheme x:Key="Brand" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource Brand}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brand}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </ControlTheme>

    <!-- Круглая кнопка со значком: настройки, закрыть, назад -->
    <ControlTheme x:Key="Round" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
    </ControlTheme>

    <!-- Строка меню: подпись слева, подсветка во всю ширину -->
    <ControlTheme x:Key="MenuRow" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        </Style>
    </ControlTheme>

    <!-- Вкладка провайдера: пилюля, выбранная — фирменным градиентом -->
    <ControlTheme x:Key="Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Pill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PillLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="13,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource Brand}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </ControlTheme>

    <!-- Сегмент выбора: язык, тема, интервал — вместо выпадающих списков -->
    <ControlTheme x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource SegmentOn}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </ControlTheme>

    <!-- Переключатель iOS: подпись слева, ползунок справа, включённый — зелёный -->
    <ControlTheme x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      VerticalAlignment="Center"/>
                    <Border Name="Track" Grid.Column="1" Width="44" Height="26" CornerRadius="13"
                            Margin="12,0,0,0" VerticalAlignment="Center" Background="{DynamicResource SwitchOff}">
                        <Ellipse Name="Knob" Width="22" Height="22" Margin="2,0,0,0" Fill="White"
                                 HorizontalAlignment="Left" RenderTransform="translateX(0px)">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"
                                                                   Easing="CubicEaseOut"/>
                                </Transitions>
                            </Ellipse.Transitions>
                        </Ellipse>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Track">
            <Setter Property="Background" Value="{DynamicResource Switch}"/>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Knob">
            <Setter Property="RenderTransform" Value="translateX(18px)"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </ControlTheme>

    <!-- Полоска квоты: ширину заливки считает сам ProgressBar по PART_Indicator -->
    <ControlTheme x:Key="Meter" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="{DynamicResource Track}"/>
        <Setter Property="Foreground" Value="{DynamicResource MeterGood}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                    <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{TemplateBinding Foreground}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
