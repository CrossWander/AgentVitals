<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentVitals.SettingsPanel"
             x:ClassModifier="internal">
    <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*">
            <Button Theme="{StaticResource Round}" Click="OnBack">
                <Path Classes="icon" Data="{StaticResource IconBack}" Stroke="{Binding $parent[Button].Foreground}"/>
            </Button>
            <TextBlock Grid.Column="1" Text="{DynamicResource langSettings}" FontSize="18" FontWeight="Bold"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="{DynamicResource langLanguage}"/>
                    <Border Classes="track" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Name="LanguageEn" Theme="{StaticResource Segment}" GroupName="language" Tag="en"
                                         Content="English" IsCheckedChanged="OnLanguage"/>
                            <RadioButton Name="LanguageRu" Theme="{StaticResource Segment}" GroupName="language" Tag="ru"
                                         Content="Русский" IsCheckedChanged="OnLanguage"/>
                            <RadioButton Name="LanguageUk" Theme="{StaticResource Segment}" GroupName="language" Tag="uk"
                                         Content="Українська" IsCheckedChanged="OnLanguage"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="{DynamicResource langTheme}"/>
                    <Border Classes="track" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Name="ThemeAuto" Theme="{StaticResource Segment}" GroupName="theme" Tag="Auto"
                                         Content="{DynamicResource langThemeAuto}" IsCheckedChanged="OnTheme"/>
                            <RadioButton Name="ThemeLight" Theme="{StaticResource Segment}" GroupName="theme" Tag="Light"
                                         Content="{DynamicResource langThemeLight}" IsCheckedChanged="OnTheme"/>
                            <RadioButton Name="ThemeDark" Theme="{StaticResource Segment}" GroupName="theme" Tag="Dark"
                                         Content="{DynamicResource langThemeDark}" IsCheckedChanged="OnTheme"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="{DynamicResource langInterval}"/>
                    <Border Classes="track" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tag — интервал в секундах -->
                            <RadioButton Name="Interval1" Theme="{StaticResource Segment}" GroupName="interval" Tag="60"
                                         Content="{DynamicResource langMinutes1}" IsCheckedChanged="OnInterval"/>
                            <RadioButton Name="Interval2" Theme="{StaticResource Segment}" GroupName="interval" Tag="120"
                                         Content="{DynamicResource langMinutes2}" IsCheckedChanged="OnInterval"/>
                            <RadioButton Name="Interval5" Theme="{StaticResource Segment}" GroupName="interval" Tag="300"
                                         Content="{DynamicResource langMinutes5}" IsCheckedChanged="OnInterval"/>
                            <RadioButton Name="Interval10" Theme="{StaticResource Segment}" GroupName="interval" Tag="600"
                                         Content="{DynamicResource langMinutes10}" IsCheckedChanged="OnInterval"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Name="AutostartCard" Classes="card">
            <CheckBox Name="AutostartToggle" Theme="{StaticResource Toggle}" Content="{DynamicResource langAutostart}"
                      IsCheckedChanged="OnAutostart"/>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="label" Text="{DynamicResource langHooks}"/>
                <TextBlock Name="HooksState" Classes="caption" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="HooksConnect" Theme="{StaticResource Brand}" Content="{DynamicResource langHooksConnect}"
                            Click="OnConnect"/>
                    <Button Name="HooksDisconnect" Theme="{StaticResource Pill}" Content="{DynamicResource langHooksDisconnect}"
                            Click="OnDisconnect"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Button Theme="{StaticResource Pill}" HorizontalAlignment="Left" Click="OnExit">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" Data="{StaticResource IconPower}" Stroke="{Binding $parent[Button].Foreground}"/>
                <TextBlock Text="{DynamicResource langExitApp}"/>
            </StackPanel>
        </Button>

        <!-- Подвал: авторство и версия -->
        <TextBlock Name="Credits" Classes="faint" Margin="2,-4,0,0"/>
    </StackPanel>
</UserControl>
