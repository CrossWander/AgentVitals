<?xml version="1.0" encoding="utf-8"?>
<!-- Только nuget.org: унаследованные корпоративные источники и их отключения сюда не доходят,
     иначе restore не находит Avalonia и runtime packs под win-x64. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
