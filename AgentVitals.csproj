<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Switch по enum без «_»: забытое значение — ошибка сборки, а неименованное число и так бросит исключение. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS8524</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>AgentVitals</AssemblyName>
    <RootNamespace>AgentVitals</RootNamespace>
    <!-- Сборка релиза на GitHub берёт версию из тега; эта — для сборок у себя. -->
    <Version>1.1.0</Version>
    <Authors>Dykalo Pavlo</Authors>
    <Copyright>© 2026 Dykalo Pavlo</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Product>AgentVitals</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="app.png" />
    <InternalsVisibleTo Include="AgentVitals.Tests" />
  </ItemGroup>

  <!-- У тестов свой проект в своей папке: в сборку программы их файлы не попадают -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <AvaloniaXaml Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

</Project>
