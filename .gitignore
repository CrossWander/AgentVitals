bin/
obj/

# файлы, которые программа создаёт рядом с собой при запуске; папка состояний сессий
# лежит рядом с exe в bin/ или release/ — отдельное правило для неё скрыло бы исходники
# в Sessions/: git на Windows сравнивает имена без учёта регистра
config.json
log.txt

# сборка, как bin/ и obj/: exe — результат tools\publish.ps1, в git ему не место;
# людям его отдаёт релиз на GitHub (.github/workflows/release.yml)
release/

# служебные файлы Visual Studio
.vs/
*.user
