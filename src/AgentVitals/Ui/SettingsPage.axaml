<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentVitals.SettingsPage"
             x:ClassModifier="internal">

    <!-- Вкладка «Настройки» окна AgentVitals устроена как «Агенты»: разделы слева, справа — строки выбранного,
         «название — переключатель». Новая настройка — строка в своём разделе, сетку она не ломает -->
    <UserControl.Styles>
        <Style Selector="Border.rows">
            <Setter Property="BorderBrush" Value="{DynamicResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <!-- Строки разделены чертой сверху; у первой её нет -->
        <Style Selector="Border.row">
            <Setter Property="BorderBrush" Value="{DynamicResource CardLine}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="MinHeight" Value="52"/>
        </Style>
        <Style Selector="Border.row:nth-child(1)">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Border.row TextBlock.name">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.row > CheckBox">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
        <!-- Есть новая версия: строка о ней — цветом -->
        <Style Selector="TextBlock.newer">
            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
        </Style>
        <Style Selector="Path.section">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stroke" Value="{DynamicResource TextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Карточка вида виджета: выбранная — синей рамкой -->
        <Style Selector="RadioButton.look">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardLine}"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="RadioButton.look:checked">
            <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
        </Style>
        <Style Selector="RadioButton.look TextBlock.name">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.screen">
            <Setter Property="Height" Value="92"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#22303F"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.taskbar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#0E1216"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="270,*" ColumnSpacing="14">
        <!-- Разделы. Tag — имя раздела: по нему же заголовок и подсказка справа -->
        <Border Classes="card" Padding="6" VerticalAlignment="Top">
            <StackPanel Spacing="2">
                <RadioButton Name="GeneralTab" Theme="{StaticResource ListRow}" GroupName="section" Tag="General" IsCheckedChanged="OnSection">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Path Classes="icon section" Data="{StaticResource IconToggles}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="section" Text="{DynamicResource langGeneral}"/>
                            <TextBlock Classes="note" Text="{DynamicResource langGeneralNote}"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <RadioButton Theme="{StaticResource ListRow}" GroupName="section" Tag="Notifications" IsCheckedChanged="OnSection">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Path Classes="icon section" Data="{StaticResource IconBell}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="section" Text="{DynamicResource langNotifications}"/>
                            <TextBlock Classes="note" Text="{DynamicResource langNotificationsNote}"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <RadioButton Name="WidgetTab" Theme="{StaticResource ListRow}" GroupName="section" Tag="Widget" IsCheckedChanged="OnSection">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Path Classes="icon section" Data="{StaticResource IconWidget}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="section" Text="{DynamicResource langWidget}"/>
                            <TextBlock Classes="note" Text="{DynamicResource langWidgetNote}"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <RadioButton Theme="{StaticResource ListRow}" GroupName="section" Tag="System" IsCheckedChanged="OnSection">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Path Classes="icon section" Data="{StaticResource IconRefresh}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="section" Text="{DynamicResource langSystem}"/>
                            <!-- Есть новая версия — здесь, цветом -->
                            <TextBlock Name="SystemNote" Classes="note"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <RadioButton Theme="{StaticResource ListRow}" GroupName="section" Tag="About" IsCheckedChanged="OnSection">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Path Classes="icon section" Data="{StaticResource IconInfo}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="section" Text="{DynamicResource langAbout}"/>
                            <TextBlock Name="AboutNote" Classes="note"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Справа — выбранный раздел. Прокручивается целиком: окно на малом экране не выше рабочей области -->
        <Border Grid.Column="1" Classes="card" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16" Spacing="12">
                    <StackPanel Name="SectionHead" Spacing="2">
                        <TextBlock Name="SectionTitle" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Name="SectionHint" FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Name="GeneralRows" Classes="rows">
                        <StackPanel>
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="name" Text="{DynamicResource langLanguage}"/>
                                    <Border Grid.Column="1" Classes="track" VerticalAlignment="Center">
                                        <StackPanel Name="Languages" Orientation="Horizontal">
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="language" Tag="en"
                                                         Content="English" IsCheckedChanged="OnLanguage"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="language" Tag="ru"
                                                         Content="Русский" IsCheckedChanged="OnLanguage"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="language" Tag="uk"
                                                         Content="Українська" IsCheckedChanged="OnLanguage"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="name" Text="{DynamicResource langTheme}"/>
                                    <Border Grid.Column="1" Classes="track" VerticalAlignment="Center">
                                        <StackPanel Name="Themes" Orientation="Horizontal">
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="theme" Tag="Auto"
                                                         Content="{DynamicResource langThemeAuto}" IsCheckedChanged="OnTheme"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="theme" Tag="Light"
                                                         Content="{DynamicResource langThemeLight}" IsCheckedChanged="OnTheme"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="theme" Tag="Dark"
                                                         Content="{DynamicResource langThemeDark}" IsCheckedChanged="OnTheme"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="name" Text="{DynamicResource langInterval}"/>
                                    <Border Grid.Column="1" Classes="track" VerticalAlignment="Center">
                                        <!-- Tag — значение настройки: код языка, ThemeMode, интервал в секундах -->
                                        <StackPanel Name="Intervals" Orientation="Horizontal">
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="interval" Tag="60"
                                                         Content="{DynamicResource langMinutes1}" IsCheckedChanged="OnInterval"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="interval" Tag="120"
                                                         Content="{DynamicResource langMinutes2}" IsCheckedChanged="OnInterval"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="interval" Tag="300"
                                                         Content="{DynamicResource langMinutes5}" IsCheckedChanged="OnInterval"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="interval" Tag="600"
                                                         Content="{DynamicResource langMinutes10}" IsCheckedChanged="OnInterval"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- Смысл процентов во всей программе; Tag — PercentMode -->
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Classes="name" Text="{DynamicResource langPercent}"/>
                                        <TextBlock Classes="note" Text="{DynamicResource langPercentHint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="track" VerticalAlignment="Center">
                                        <StackPanel Name="Percents" Orientation="Horizontal">
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="percent" Tag="Used"
                                                         Content="{DynamicResource langPercentUsed}" IsCheckedChanged="OnPercent"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="percent" Tag="Left"
                                                         Content="{DynamicResource langPercentLeft}" IsCheckedChanged="OnPercent"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Name="NotificationsRows" Classes="rows" IsVisible="False">
                        <StackPanel>
                            <!-- Пороги тостов о квоте: Tag — какой порог и шаг; границы и порядок держит QuotaAlarm.Shift -->
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Name="ImportantName" Classes="name"/>
                                    <Button Grid.Column="1" Theme="{StaticResource Round}" Width="26" Height="26" Content="−"
                                            VerticalAlignment="Center" Tag="important:-5" Click="OnLevel"/>
                                    <TextBlock Grid.Column="2" Name="ImportantValue" Width="48" TextAlignment="Center"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Theme="{StaticResource Round}" Width="26" Height="26" Content="+"
                                            VerticalAlignment="Center" Tag="important:5" Click="OnLevel"/>
                                </Grid>
                            </Border>
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Name="CriticalName" Classes="name"/>
                                    <Button Grid.Column="1" Theme="{StaticResource Round}" Width="26" Height="26" Content="−"
                                            VerticalAlignment="Center" Tag="critical:-5" Click="OnLevel"/>
                                    <TextBlock Grid.Column="2" Name="CriticalValue" Width="48" TextAlignment="Center"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Theme="{StaticResource Round}" Width="26" Height="26" Content="+"
                                            VerticalAlignment="Center" Tag="critical:5" Click="OnLevel"/>
                                </Grid>
                            </Border>
                            <Border Name="LowSoundRow" Classes="row">
                                <CheckBox Name="LowSoundToggle" Theme="{StaticResource Toggle}" Content="{DynamicResource langLowSound}"
                                          IsCheckedChanged="OnLowSound"/>
                            </Border>
                            <Border Classes="row">
                                <CheckBox Name="SessionToastsToggle" Theme="{StaticResource Toggle}" Content="{DynamicResource langSessionToasts}"
                                          IsCheckedChanged="OnSessionToasts"/>
                            </Border>
                            <Border Name="TurnPanel" Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="name" Text="{DynamicResource langTurnLonger}"/>
                                    <Border Grid.Column="1" Classes="track" VerticalAlignment="Center">
                                        <!-- Tag — минуты; 0 — о любом ходе -->
                                        <StackPanel Name="TurnMinutes" Orientation="Horizontal">
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="turn" Tag="0"
                                                         Content="{DynamicResource langAnyTurn}" IsCheckedChanged="OnTurnMinutes"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="turn" Tag="1"
                                                         Content="{DynamicResource langMinutes1}" IsCheckedChanged="OnTurnMinutes"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="turn" Tag="5"
                                                         Content="{DynamicResource langMinutes5}" IsCheckedChanged="OnTurnMinutes"/>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="turn" Tag="15"
                                                         Content="{DynamicResource langMinutes15}" IsCheckedChanged="OnTurnMinutes"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Name="WaitingSoundRow" Classes="row">
                                <CheckBox Name="WaitingSoundToggle" Theme="{StaticResource Toggle}" Content="{DynamicResource langWaitingSound}"
                                          IsCheckedChanged="OnWaitingSound"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Вид виджета: четыре карточки с картинкой, включён один. Tag — WidgetKind; картинки — как на доске
                         «Настройки → Виджет», цвета у них свои: это рисунок экрана, а не часть темы -->
                    <StackPanel Name="WidgetRows" IsVisible="False" Spacing="12">
                        <UniformGrid Name="WidgetKinds" Columns="2">
                            <RadioButton Classes="look" Theme="{StaticResource ListRow}" GroupName="widget" Tag="Off" IsCheckedChanged="OnWidget">
                                <StackPanel Spacing="8">
                                    <Border Classes="screen">
                                        <Border Classes="taskbar"/>
                                    </Border>
                                    <TextBlock Classes="name" Text="{DynamicResource langWidgetOff}"/>
                                    <TextBlock Classes="note" Text="{DynamicResource langWidgetOffNote}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="look" Theme="{StaticResource ListRow}" GroupName="widget" Tag="Notch" IsCheckedChanged="OnWidget">
                                <StackPanel Spacing="8">
                                    <Border Classes="screen">
                                        <Panel>
                                            <Border Width="76" Height="3" CornerRadius="0,0,2,2" Background="#34D399"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                            <Border Classes="taskbar"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Classes="name" Text="{DynamicResource langWidgetNotch}"/>
                                    <TextBlock Classes="note" Text="{DynamicResource langWidgetNotchNote}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="look" Theme="{StaticResource ListRow}" GroupName="widget" Tag="Chip" IsCheckedChanged="OnWidget">
                                <StackPanel Spacing="8">
                                    <Border Classes="screen">
                                        <Panel>
                                            <Border Width="54" Height="16" CornerRadius="8" Margin="0,0,8,16" Background="#F21C1C1E"
                                                    BorderBrush="#33FFFFFF" BorderThickness="1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            <Border Classes="taskbar"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Classes="name" Text="{DynamicResource langWidgetChip}"/>
                                    <TextBlock Classes="note" Text="{DynamicResource langWidgetChipNote}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="look" Theme="{StaticResource ListRow}" GroupName="widget" Tag="Desktop" IsCheckedChanged="OnWidget">
                                <StackPanel Spacing="8">
                                    <Border Classes="screen">
                                        <Panel>
                                            <Border Width="96" Height="58" CornerRadius="8" Margin="0,14,18,0" Background="#990A0E14"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            <Border Width="150" Height="72" CornerRadius="4" Margin="14,10,0,0" Background="#1E1E1E"
                                                    BorderBrush="#343A40" BorderThickness="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <Border Classes="taskbar"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Classes="name" Text="{DynamicResource langWidgetDesktop}"/>
                                    <TextBlock Classes="note" Text="{DynamicResource langWidgetDesktopNote}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <!-- Строка выбранного вида: у плашки — что видно в покое, у значка — как показать нескольких агентов.
                             Tag — значение bool -->
                        <Border Name="WidgetOptions" Classes="rows">
                            <StackPanel>
                                <Border Name="NotchRow" Classes="row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="name" Text="{DynamicResource langNotchRest}"/>
                                            <TextBlock Classes="note" Text="{DynamicResource langNotchRestHint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="track" VerticalAlignment="Center">
                                            <StackPanel Name="NotchRests" Orientation="Horizontal">
                                                <RadioButton Theme="{StaticResource Segment}" GroupName="notch" Tag="False"
                                                             Content="{DynamicResource langNotchStrip}" IsCheckedChanged="OnNotchRest"/>
                                                <RadioButton Theme="{StaticResource Segment}" GroupName="notch" Tag="True"
                                                             Content="{DynamicResource langNotchPill}" IsCheckedChanged="OnNotchRest"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Name="ChipRow" Classes="row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="name" Text="{DynamicResource langChipAgents}"/>
                                            <TextBlock Classes="note" Text="{DynamicResource langChipAgentsHint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="track" VerticalAlignment="Center">
                                            <StackPanel Name="ChipAgents" Orientation="Horizontal">
                                                <RadioButton Theme="{StaticResource Segment}" GroupName="chip" Tag="False"
                                                             Content="{DynamicResource langChipRow}" IsCheckedChanged="OnChipAgents"/>
                                                <RadioButton Theme="{StaticResource Segment}" GroupName="chip" Tag="True"
                                                             Content="{DynamicResource langChipTurns}" IsCheckedChanged="OnChipAgents"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="note" Text="{DynamicResource langWidgetEye}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Name="SystemRows" Classes="rows" IsVisible="False">
                        <StackPanel>
                            <Border Name="AutostartCard" Classes="row">
                                <CheckBox Name="AutostartToggle" Theme="{StaticResource Toggle}" Content="{DynamicResource langAutostart}"
                                          IsCheckedChanged="OnAutostart"/>
                            </Border>
                            <Border Classes="row">
                                <CheckBox Name="AutoUpdateToggle" Theme="{StaticResource Toggle}" Content="{DynamicResource langAutoUpdate}"
                                          IsCheckedChanged="OnAutoUpdate"/>
                            </Border>
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Name="UpdateLine" Classes="name" TextWrapping="Wrap"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Name="UpdateInstall" Theme="{StaticResource Brand}" Content="{DynamicResource langInstallUpdate}"
                                                Click="OnInstallUpdate"/>
                                        <Button Name="UpdateCheck" Theme="{StaticResource Pill}" Content="{DynamicResource langCheckUpdates}"
                                                Click="OnCheckUpdates"/>
                                        <Button Name="UpdateOpen" Theme="{StaticResource Pill}" Content="{DynamicResource langUpdateOpen}"
                                                Click="OnOpenReleases"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- О программе: кто сделал, версия, ссылки. Заголовка над ним нет — всё по центру -->
                    <StackPanel Name="AboutView" IsVisible="False" HorizontalAlignment="Center" Spacing="8" Margin="0,48,0,0">
                        <Image Source="avares://AgentVitals/app.png" Width="64" Height="64" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <TextBlock Text="AgentVitals" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Name="AboutLine" FontSize="14" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Developed by Dykalo Pavlo, 2026" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Theme="{StaticResource Pill}" Content="GitHub" Click="OnOpenRepository"/>
                            <Button Name="WhatsNew" Theme="{StaticResource Pill}" Click="OnWhatsNew"/>
                        </StackPanel>
                        <TextBlock Classes="faint" Text="Apache License 2.0" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
