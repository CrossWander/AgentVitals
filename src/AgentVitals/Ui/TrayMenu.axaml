<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AgentVitals.TrayMenu"
        x:ClassModifier="internal"
        Title="AgentVitals"
        Width="284" SizeToContent="Height" CanResize="False"
        WindowDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">

    <Border Classes="window" Margin="16,12,16,20" Padding="6">
        <StackPanel>
            <Button Theme="{StaticResource MenuRow}" Click="OnRefresh">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="icon" Data="{StaticResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}"/>
                    <TextBlock Text="{DynamicResource langRefresh}"/>
                </StackPanel>
            </Button>
            <Button Theme="{StaticResource MenuRow}" Click="OnAgents">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="icon" Data="{StaticResource IconAgents}" Stroke="{Binding $parent[Button].Foreground}"/>
                    <TextBlock Text="{DynamicResource langAgentsMenu}"/>
                </StackPanel>
            </Button>
            <Button Theme="{StaticResource MenuRow}" Click="OnSettings">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="icon" Data="{StaticResource IconGear}" Fill="{Binding $parent[Button].Foreground}"/>
                    <TextBlock Text="{DynamicResource langSettings}"/>
                </StackPanel>
            </Button>
            <Border Classes="rule" Margin="10,4"/>
            <!-- «Не беспокоить»: выключено — сроки (переносятся по длине подписей) и сноска; включено — до какого времени и
                 «Выключить». Tag — QuietSpan, без Tag — выключить -->
            <StackPanel Name="QuietChoices" Margin="12,6,12,4" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="icon" Data="{StaticResource IconMoon}" Stroke="{DynamicResource Text}"/>
                    <TextBlock Text="{DynamicResource langQuiet}" FontSize="13"/>
                </StackPanel>
                <WrapPanel>
                    <Button Theme="{StaticResource Pill}" Padding="10,5" FontSize="12" Margin="0,0,6,6" Tag="HalfHour"
                            Content="{DynamicResource langQuietHalfHour}" Click="OnQuiet"/>
                    <Button Theme="{StaticResource Pill}" Padding="10,5" FontSize="12" Margin="0,0,6,6" Tag="Hour"
                            Content="{DynamicResource langQuietHour}" Click="OnQuiet"/>
                    <Button Theme="{StaticResource Pill}" Padding="10,5" FontSize="12" Margin="0,0,6,6" Tag="Morning"
                            Content="{DynamicResource langQuietMorning}" Click="OnQuiet"/>
                    <Button Theme="{StaticResource Pill}" Padding="10,5" FontSize="12" Margin="0,0,6,6" Tag="Forever"
                            Content="{DynamicResource langQuietForever}" Click="OnQuiet"/>
                </WrapPanel>
                <TextBlock Classes="faint" Text="{DynamicResource langQuietNote}" TextWrapping="Wrap" Margin="0,-6,0,0"/>
            </StackPanel>
            <Grid Name="QuietActive" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,6,12,6" IsVisible="False">
                <Path Classes="icon" Data="{StaticResource IconMoon}" Stroke="{DynamicResource Text}" VerticalAlignment="Center"/>
                <TextBlock Name="QuietUntil" Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Theme="{StaticResource Pill}" Padding="10,5" FontSize="12" VerticalAlignment="Center"
                        Content="{DynamicResource langQuietStop}" Click="OnQuiet"/>
            </Grid>
            <Border Classes="rule" Margin="10,4"/>
            <Button Theme="{StaticResource MenuRow}" Click="OnExit">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="icon" Data="{StaticResource IconPower}" Stroke="{Binding $parent[Button].Foreground}"/>
                    <TextBlock Text="{DynamicResource langExit}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
