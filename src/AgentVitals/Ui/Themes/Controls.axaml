<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Свой вид у каждого контрола: от Fluent остаётся только основа окна и текста.
         Цвета — роли палитры, поэтому смена темы перекрашивает всё сама. -->

    <!-- Пилюля: обычная кнопка с подписью и значком -->
    <ControlTheme x:Key="Pill" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource PillFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PillLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </ControlTheme>

    <!-- Главное действие экрана: фирменный градиент -->
    <ControlTheme x:Key="Brand" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource BrandFill}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrandFill}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </ControlTheme>

    <!-- Круглая кнопка со значком: настройки, закрыть, назад -->
    <ControlTheme x:Key="Round" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
    </ControlTheme>

    <!-- Бледный значок без подложки — ✕ тоста, глаз у почты: не спорит с текстом, ярче под мышью -->
    <ControlTheme x:Key="Faint" TargetType="Button" BasedOn="{StaticResource Round}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
    </ControlTheme>

    <!-- Строка меню: подпись слева, подсветка во всю ширину -->
    <ControlTheme x:Key="MenuRow" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        </Style>
    </ControlTheme>

    <!-- Вкладка агента: пилюля, выбранная — фирменным градиентом -->
    <ControlTheme x:Key="Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource PillFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PillLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="13,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource BrandFill}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </ControlTheme>

    <!-- Сегмент выбора: язык, тема, интервал — вместо выпадающих списков, пока варианты умещаются в ряд -->
    <ControlTheme x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource SegmentOn}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </ControlTheme>

    <!-- Выпадающий список — где вариантов много или их число меняется, как у агентов. Закрытый — дорожка с одним
         выбранным сегментом и стрелкой, как соседние сегменты; открытый — подложка окна, строки как в меню -->
    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Background" Background="{DynamicResource Track}" CornerRadius="10" Padding="2">
                        <Border Background="{DynamicResource SegmentOn}" CornerRadius="8" Padding="11,5,10,5">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                <!-- Стрелка в своих точках и без класса icon: стиль Path.icon сильнее значений из шаблона,
                                     его 13×13 с растяжением прижимали стрелку к верху -->
                                <Path Name="Arrow" Grid.Column="1" Width="10" Height="6" Data="M1,1 L5,5 L9,1"
                                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                      Stroke="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Поле вокруг — под тень: окно списка прозрачное, тень внутри него -->
                    <Popup Name="PART_Popup" WindowManagerAddShadowHint="False" PlacementTarget="Background"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" IsLightDismissEnabled="True"
                           InheritsTransform="True">
                        <Border Background="{DynamicResource Window}" BorderBrush="{DynamicResource CardLine}" BorderThickness="1"
                                CornerRadius="12" Padding="4" Margin="10,4,10,16" BoxShadow="0 6 18 0 #40000000"
                                MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Path#Arrow">
            <Setter Property="Stroke" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </ControlTheme>

    <!-- Строка выпадающего списка: как строка меню; выбранная — на дорожке и жирнее -->
    <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource Track}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </ControlTheme>

    <!-- Переключатель iOS: подпись слева, ползунок справа, включённый — зелёный -->
    <ControlTheme x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      VerticalAlignment="Center"/>
                    <Border Name="Track" Grid.Column="1" Width="44" Height="26" CornerRadius="13"
                            Margin="12,0,0,0" VerticalAlignment="Center" Background="{DynamicResource SwitchOff}">
                        <Ellipse Name="Knob" Width="22" Height="22" Margin="2,0,0,0" Fill="White"
                                 HorizontalAlignment="Left" RenderTransform="translateX(0px)">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"
                                                                   Easing="CubicEaseOut"/>
                                </Transitions>
                            </Ellipse.Transitions>
                        </Ellipse>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Track">
            <Setter Property="Background" Value="{DynamicResource Switch}"/>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Knob">
            <Setter Property="RenderTransform" Value="translateX(18px)"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </ControlTheme>

    <!-- Вкладка окна AgentVitals: сегмент на дорожке, как переключатель аккаунтов; выбранная — светлая, с тенью -->
    <ControlTheme x:Key="PageTab" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 1 3 0 #26000000"/>
        </Style>
    </ControlTheme>

    <!-- Строка списка слева в окне AgentVitals — раздел настроек: подсветка во всю ширину, выбранная — в рамке -->
    <ControlTheme x:Key="ListRow" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PillLine}"/>
        </Style>
    </ControlTheme>

    <!-- Маленький переключатель без подписи — в строке списка агентов -->
    <ControlTheme x:Key="SmallToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Track" Width="34" Height="20" CornerRadius="10" Background="{DynamicResource SwitchOff}">
                    <Ellipse Name="Knob" Width="16" Height="16" Margin="2,0,0,0" Fill="White"
                             HorizontalAlignment="Left" RenderTransform="translateX(0px)">
                        <Ellipse.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"
                                                               Easing="CubicEaseOut"/>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Track">
            <Setter Property="Background" Value="{DynamicResource Switch}"/>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Knob">
            <Setter Property="RenderTransform" Value="translateX(14px)"/>
        </Style>
    </ControlTheme>

    <!-- Полоска квоты: ширину заливки считает сам ProgressBar по PART_Indicator -->
    <ControlTheme x:Key="Meter" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="{DynamicResource Track}"/>
        <Setter Property="Foreground" Value="{DynamicResource MeterGood}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                    <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{TemplateBinding Foreground}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Метка ровного темпа поверх полоски: ширину до неё тоже считает ProgressBar, видна только правая грань -->
    <ControlTheme x:Key="PaceMark" TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Indicator" HorizontalAlignment="Left" BorderThickness="0,0,2,0"
                            BorderBrush="{TemplateBinding Foreground}"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Прокрутка как в macOS: тонкий скруглённый ползунок поверх содержимого, без стрелок и дорожки.
         Виден всегда, когда есть что прокручивать, — иначе не понять, что окно длиннее; над ползунком ярче.
         Тема без ключа — для всех ScrollBar программы вместо Fluent. -->
    <ControlTheme x:Key="OverlayThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollThumb}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                           DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
                        <Thumb Theme="{StaticResource OverlayThumb}" Width="6" CornerRadius="3" MinHeight="20"
                               HorizontalAlignment="Right" Margin="0,2,2,2">
                            <Thumb.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.15"/>
                                </Transitions>
                            </Thumb.Transitions>
                        </Thumb>
                    </Track>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="11"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}"
                           DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
                        <Thumb Theme="{StaticResource OverlayThumb}" Height="6" CornerRadius="3" MinWidth="20"
                               VerticalAlignment="Bottom" Margin="2,0,2,2">
                            <Thumb.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Height" Duration="0:0:0.15"/>
                                </Transitions>
                            </Thumb.Transitions>
                        </Thumb>
                    </Track>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Мышь на ползунке или его тянут: виден и шире -->
        <Style Selector="^[IsExpanded=true]">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="^:vertical[IsExpanded=true] /template/ Thumb">
            <Setter Property="Width" Value="9"/>
            <Setter Property="CornerRadius" Value="4.5"/>
        </Style>
        <Style Selector="^:horizontal[IsExpanded=true] /template/ Thumb">
            <Setter Property="Height" Value="9"/>
            <Setter Property="CornerRadius" Value="4.5"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
