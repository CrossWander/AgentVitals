<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Роли цветов по образцу ClaudeBar. Разметка обращается к ролям через DynamicResource,
         а значения Avalonia подставляет по варианту темы — о теме разметка не знает вовсе. -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Нейтральный графит, как системная тёмная тема iOS: раскладка ClaudeBar без его фиолетового -->
            <LinearGradientBrush x:Key="Window" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#1C1C1E"/>
                <GradientStop Offset="1" Color="#2A2A2D"/>
            </LinearGradientBrush>
            <!-- Карточки — «стекло»: полупрозрачный белый поверх градиента -->
            <SolidColorBrush x:Key="Card" Color="#12FFFFFF"/>
            <SolidColorBrush x:Key="CardHover" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="CardLine" Color="#1FFFFFFF"/>
            <!-- Ползунок прокрутки, как в macOS: полупрозрачный, под мышью плотнее -->
            <SolidColorBrush x:Key="ScrollThumb" Color="#59FFFFFF"/>
            <SolidColorBrush x:Key="ScrollThumbHover" Color="#99FFFFFF"/>
            <SolidColorBrush x:Key="PillFill" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="PillLine" Color="#2EFFFFFF"/>
            <SolidColorBrush x:Key="Track" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="SegmentOn" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="SwitchOff" Color="#40FFFFFF"/>
            <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextDim" Color="#AEAEB2"/>
            <SolidColorBrush x:Key="TextFaint" Color="#8E8E93"/>
            <SolidColorBrush x:Key="Good" Color="#34D399"/>
            <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
            <SolidColorBrush x:Key="Bad" Color="#F87171"/>
            <SolidColorBrush x:Key="Muted" Color="#8E8E93"/>
            <SolidColorBrush x:Key="Blue" Color="#60A5FA"/>
            <!-- Аккаунт, показанный в карточках сверху, и полоса «это последние цифры» -->
            <SolidColorBrush x:Key="AccountPick" Color="#1A60A5FA"/>
            <SolidColorBrush x:Key="HintFill" Color="#1AFBBF24"/>
            <SolidColorBrush x:Key="HintLine" Color="#4DFBBF24"/>
            <SolidColorBrush x:Key="HintText" Color="#FDE68A"/>
            <SolidColorBrush x:Key="Well" Color="#0DFFFFFF"/>
            <SolidColorBrush x:Key="GoodFill" Color="#2934D399"/>
            <SolidColorBrush x:Key="GoodText" Color="#6EE7B7"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Светлый ледяной голубой с тёплым уходом к углу — пара к тёмному морскому -->
            <LinearGradientBrush x:Key="Window" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#EEF4FA"/>
                <GradientStop Offset="1" Color="#F7F3F0"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardHover" Color="#EEF4FA"/>
            <SolidColorBrush x:Key="CardLine" Color="#E0E8F0"/>
            <SolidColorBrush x:Key="ScrollThumb" Color="#47000000"/>
            <SolidColorBrush x:Key="ScrollThumbHover" Color="#80000000"/>
            <SolidColorBrush x:Key="PillFill" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PillLine" Color="#D5DFE9"/>
            <SolidColorBrush x:Key="Track" Color="#E2E9F0"/>
            <SolidColorBrush x:Key="SegmentOn" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SwitchOff" Color="#D2DCE6"/>
            <SolidColorBrush x:Key="Text" Color="#13202E"/>
            <SolidColorBrush x:Key="TextDim" Color="#5A6B7D"/>
            <SolidColorBrush x:Key="TextFaint" Color="#93A3B4"/>
            <SolidColorBrush x:Key="Good" Color="#10B981"/>
            <SolidColorBrush x:Key="Warn" Color="#D97706"/>
            <SolidColorBrush x:Key="Bad" Color="#E11D48"/>
            <SolidColorBrush x:Key="Muted" Color="#93A3B4"/>
            <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
            <SolidColorBrush x:Key="AccountPick" Color="#143B82F6"/>
            <SolidColorBrush x:Key="HintFill" Color="#FFF7ED"/>
            <SolidColorBrush x:Key="HintLine" Color="#FED7AA"/>
            <SolidColorBrush x:Key="HintText" Color="#7C2D12"/>
            <SolidColorBrush x:Key="Well" Color="#F3F6FA"/>
            <SolidColorBrush x:Key="GoodFill" Color="#D1FAE5"/>
            <SolidColorBrush x:Key="GoodText" Color="#065F46"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Общие для обеих тем: фирменный градиент (он же у иконки), полоски, бейджи, значки карточек -->
    <LinearGradientBrush x:Key="BrandFill" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FF7A59"/>
        <GradientStop Offset="1" Color="#FF2D55"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MeterGood" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#38BDF8"/>
        <GradientStop Offset="1" Color="#34D399"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MeterWarn" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#FCD34D"/>
        <GradientStop Offset="1" Color="#F59E0B"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MeterBad" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#FB923C"/>
        <GradientStop Offset="1" Color="#EF4444"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MeterMuted" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="BadgeGood" Color="#22C55E"/>
    <SolidColorBrush x:Key="BadgeWarn" Color="#F59E0B"/>
    <SolidColorBrush x:Key="BadgeBad" Color="#EF4444"/>
    <SolidColorBrush x:Key="BadgeMuted" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="Switch" Color="#34C759"/>
    <SolidColorBrush x:Key="IconSession" Color="#34D399"/>
    <SolidColorBrush x:Key="IconWeek" Color="#60A5FA"/>
    <SolidColorBrush x:Key="IconModel" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="IconExtra" Color="#FBBF24"/>
</ResourceDictionary>
